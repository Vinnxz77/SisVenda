<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SisVenda.PedidoPage"
             Title="Pedidos">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo" Clicked="Novo_Clicked" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="pedidosCollectionView" Margin="12" SelectionMode="None">
        <CollectionView.EmptyView>
            <Label Text="Nenhum pedido cadastrado." HorizontalOptions="Center" VerticalOptions="Center" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="10" Margin="0,0,0,8" Stroke="#DDDDDD">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding ClienteNome}" FontAttributes="Bold" />
                            <Label Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Itens.Count, StringFormat='Itens: {0}'}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding TotalFormatado}" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="Editar" Clicked="Editar_Clicked" CommandParameter="{Binding Id}" />
                        <Button Grid.Column="4" Text="Excluir" BackgroundColor="#FF6666" Clicked="Excluir_Clicked" CommandParameter="{Binding Id}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
