<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SisVenda.ClientePage"
             Title="Clientes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo" Clicked="ToolbarItem_Novo_Clicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="12">
            <CollectionView x:Name="clientesCollectionView" ItemsSource="{Binding}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="0,6" Stroke="#DDD">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="auto,auto,auto,auto,auto,auto,Auto,Auto" ColumnSpacing="8" >
                                <Label Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding CpfCnpj}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding TelefoneOuCelular}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding Email}" VerticalOptions="Center" />
                                <Label Grid.Column="4" Text="{Binding Endereco}" VerticalOptions="Center" />
                                <Label Grid.Column="5" Text="{Binding Cidade}" VerticalOptions="Center" />

                                <Button Grid.Column="6" Text="Editar" Clicked="Editar_Clicked" CommandParameter="{Binding Id}" Margin="4,0" WidthRequest="80" />
                                <Button Grid.Column="7" Text="Excluir" BackgroundColor="#FF6666" Clicked="Excluir_Clicked" CommandParameter="{Binding Id}" Margin="4,0" WidthRequest="80" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
